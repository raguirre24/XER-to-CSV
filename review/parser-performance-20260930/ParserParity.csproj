<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ParserStreamingParity</AssemblyName>
    <CoreProjectPath Condition="'$(CoreProjectPath)' == ''">../../XerToCsvConverter.Core/XerToCsvConverter.Core.csproj</CoreProjectPath>
    <HarnessVariant Condition="'$(HarnessVariant)' == ''">candidate</HarnessVariant>
    <EnablePhaseTelemetry Condition="'$(EnablePhaseTelemetry)' == ''">false</EnablePhaseTelemetry>
    <EnableCacheMeasurements Condition="'$(EnableCacheMeasurements)' == ''">false</EnableCacheMeasurements>
    <DefineConstants Condition="'$(EnablePhaseTelemetry)' == 'true'">$(DefineConstants);PARSER_PHASE_TELEMETRY</DefineConstants>
    <DefineConstants Condition="'$(EnableCacheMeasurements)' == 'true'">$(DefineConstants);PARSER_CACHE_EVIDENCE</DefineConstants>
    <OutputPath>bin/$(HarnessVariant)/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CoreProjectPath)" />
  </ItemGroup>
</Project>
