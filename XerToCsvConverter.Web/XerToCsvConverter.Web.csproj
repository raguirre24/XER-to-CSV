<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XerToCsvConverter.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XerToCsvConverter.Core\XerToCsvConverter.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="PublishProcessingWorker" AfterTargets="Publish" Condition="'$(SkipProcessingWorker)' != 'true'">
    <PropertyGroup>
      <_ProcessingWorkerDotNet Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_ProcessingWorkerDotNet>
      <_ProcessingWorkerDotNet Condition="'$(_ProcessingWorkerDotNet)' == ''">dotnet</_ProcessingWorkerDotNet>
    </PropertyGroup>
    <!-- The CLI re-evaluates the worker after restore so fresh builds load its WebAssembly SDK imports. -->
    <Exec Command="&quot;$(_ProcessingWorkerDotNet)&quot; publish &quot;$(MSBuildProjectDirectory)/../XerToCsvConverter.Web.Worker/XerToCsvConverter.Web.Worker.csproj&quot; --configuration &quot;$(Configuration)&quot; -p:PublishProfile= --output &quot;$(MSBuildProjectDirectory)/obj/$(Configuration)/worker-publish/&quot;" />
    <ItemGroup>
      <_ProcessingWorkerFiles Include="$(MSBuildProjectDirectory)/obj/$(Configuration)/worker-publish/wwwroot/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProcessingWorkerFiles)"
          DestinationFiles="@(_ProcessingWorkerFiles->'$(PublishDir)wwwroot/worker/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
