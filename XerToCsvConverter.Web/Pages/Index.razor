@page "/"
@implements IAsyncDisposable
@using System.Globalization
@using XerToCsvConverter.BrowserProcessing
@using XerToCsvConverter
@using XerToCsvConverter.ProgrammeReview
@using XerToCsvConverter.TenderReview
@using XerToCsvConverter.Web.Services
@inject IJSRuntime JS

<PageTitle>XER to CSV Converter</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>XER to CSV Converter</h1>
        <p>Convert Primavera P6 XER schedules using the Standard, Programme Review, or Tender Review profile</p>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h2><span class="step-number">1</span> Add XER Files</h2>
            @if (_uploadedFiles.Count > 0 || _isUploading)
            {
                <button class="btn btn-sm btn-secondary" @onclick="ClearFiles" disabled="@_isProcessing"
                        aria-label="Clear all uploaded files">Clear All</button>
            }
        </div>
        <div class="panel-body">
            <div class="drop-zone @(_isDragOver ? "drag-over" : "")"
                 role="button" tabindex="0"
                 aria-label="File upload area. Drag and drop XER files or click to browse."
                 aria-disabled="@_isBusy"
                 @ondragenter="HandleDragEnter" @ondragleave="HandleDragLeave"
                 @ondragover:preventDefault @ondrop:preventDefault>
                <InputFile @key="_fileInputGeneration" id="xer-file-input" OnChange="HandleFileSelected" multiple accept=".xer"
                           disabled="@_isBusy"
                           @ondragenter="HandleDragEnter" @ondragleave="HandleDragLeave"
                           aria-label="Select XER files to upload"
                           style="position:absolute;width:100%;height:100%;opacity:0;cursor:pointer;top:0;left:0;" />
                <span class="drop-zone-icon" aria-hidden="true">&#8682;</span>
                <p>Drag and drop XER files here or click to browse</p>
                <span class="hint">Add one or more XER files. Programme Review requires a baseline and its applicable updates; each Tender Review XER is one stage.</span>
                @if (_isUploading)
                {
                    <span role="status">Reading selected files. Clear All or change profile to cancel this upload.</span>
                }
            </div>

            @if (_uploadedFiles.Count > 0)
            {
                <ul class="file-list" role="list" aria-label="Uploaded files">
                    @foreach (UploadedFile file in _uploadedFiles)
                    {
                        <li class="file-item" role="listitem" @key="file.SourceToken">
                            <span class="file-name" title="@file.Name">@file.Name</span>
                            <span class="file-status @file.Status.ToLowerInvariant()" role="status">@file.Status</span>
                            <button class="btn-remove" @onclick="() => RemoveFile(file)" disabled="@_isProcessing"
                                    title="Remove @file.Name" aria-label="Remove @file.Name">&times;</button>
                        </li>
                    }
                </ul>
            }

            @if (_fileSizeWarning)
            {
                <div class="warning-banner" role="alert">
                    This is a high-memory browser history. Processing can take several minutes and may briefly pause during
                    report transformations. Keep this tab open and close other memory-heavy tabs. Cancellation is applied at
                    safe checkpoints; the Windows app remains more reliable for very large schedules.
                </div>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h2><span class="step-number">2</span> Export Profile</h2>
        </div>
        <div class="panel-body">
            <InputRadioGroup TValue="ExportProfile" @bind-Value="_exportProfile" Name="exportProfile">
                <div class="profile-options">
                    <label class="profile-option @(_exportProfile == ExportProfile.Standard ? "selected" : "")">
                        <InputRadio TValue="ExportProfile" Value="@ExportProfile.Standard" disabled="@_isProcessing" />
                        <span><strong>Standard / Enhanced</strong><small>Existing raw tables and optional Enhanced Power BI tables.</small></span>
                    </label>
                    <label class="profile-option @(_exportProfile == ExportProfile.ProgrammeReview ? "selected" : "")">
                        <InputRadio TValue="ExportProfile" Value="@ExportProfile.ProgrammeReview" disabled="@_isProcessing" />
                        <span><strong>Programme Review</strong><small>Schema 5.0 full-history bundle: eleven report tables, including detailed calendars, plus a manifest. Source diagnostics appear in the activity log.</small></span>
                    </label>
                    <label class="profile-option @(_exportProfile == ExportProfile.TenderReview ? "selected" : "")">
                        <InputRadio TValue="ExportProfile" Value="@ExportProfile.TenderReview" disabled="@_isProcessing" />
                        <span><strong>Tender Review</strong><small>Schema 4.0 tender-stage bundle: eleven report tables, including detailed calendars, plus a manifest. Editable status dates and source diagnostics in the activity log.</small></span>
                    </label>
                </div>
            </InputRadioGroup>

            @if (_exportProfile == ExportProfile.Standard)
            {
                <div class="toggle-row">
                    <input type="checkbox" id="chkPowerBi" @bind="_generatePowerBiTables" disabled="@_isProcessing" />
                    <label for="chkPowerBi">Include legacy Enhanced Power BI tables</label>
                </div>
            }
            else if (_exportProfile == ExportProfile.ProgrammeReview)
            {
                <div class="programme-review-editor">
                    <div class="form-grid">
                        <label>
                            <span>Project code</span>
                            <input class="form-control" @bind="_projectCode" disabled="@_isProcessing"
                                   placeholder="Example: QAC000623-01-02" autocomplete="off" />
                            <small>Project short name; spaces, punctuation, and international characters are supported.</small>
                        </label>
                        <label>
                            <span>Project name</span>
                            <input class="form-control" @bind="_projectName" disabled="@_isProcessing"
                                   placeholder="Governed project name" autocomplete="off" />
                        </label>
                        <label>
                            <span>Programme type</span>
                            <select class="form-control" @bind="_programmeType" disabled="@_isProcessing">
                                <option value="">Select C or T</option>
                                <option value="C">C - Contract</option>
                                <option value="T">T - Target</option>
                            </select>
                        </label>
                    </div>

                    @if (_uploadedFiles.Count == 0)
                    {
                        <p class="empty-hint">Add the baseline and update XER files to configure their history metadata.</p>
                    }
                    else
                    {
                        <div class="snapshot-table-wrap">
                            <table class="snapshot-table">
                                <caption>
                                    Snapshot metadata. Data date is detected from PROJECT/last_recalc_date when unambiguous
                                    and remains editable. Dates must use yyyy-MM-dd.
                                </caption>
                                <thead>
                                    <tr>
                                        <th scope="col">XER file</th>
                                        <th scope="col">Kind</th>
                                        <th scope="col">Tag</th>
                                        <th scope="col">Month update</th>
                                        <th scope="col">Data date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (UploadedFile file in _uploadedFiles)
                                    {
                                        <tr>
                                            <th scope="row" title="@file.Name">@file.Name</th>
                                            <td>
                                                <select class="form-control" @bind="file.SnapshotKind" disabled="@_isProcessing"
                                                        aria-label="Snapshot kind for @file.Name">
                                                    <option value="">Select kind</option>
                                                    <option value="Baseline">Baseline</option>
                                                    <option value="Update">Update</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input class="form-control tag-input" @bind="file.SnapshotTag" disabled="@_isProcessing"
                                                       aria-label="Snapshot tag for @file.Name" placeholder="BL01 or YYMM" />
                                            </td>
                                            <td>
                                                <input class="form-control" type="text" inputmode="numeric" placeholder="yyyy-MM-dd"
                                                       @bind="file.MonthUpdate" disabled="@_isProcessing"
                                                       aria-label="Month update for @file.Name" />
                                            </td>
                                            <td>
                                                <input class="form-control" type="text" inputmode="numeric" placeholder="yyyy-MM-dd"
                                                       @bind="file.DataDate" disabled="@_isProcessing"
                                                       aria-label="Data date for @file.Name" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="info-banner">
                            Existing filenames are preserved. The manifest generates the canonical report identity and update month-end.
                            Programme Review web limit: @MaxBrowserFiles files, @MaxBrowserFileMegabytes MB each,
                            @MaxBrowserTotalMegabytes MB total. Large histories require a 64-bit desktop browser with sufficient memory.
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="programme-review-editor">
                    <div class="form-grid tender-project-grid">
                        <label>
                            <span>Reporting project code</span>
                            <input class="form-control" @bind="_projectCode" disabled="@_isProcessing"
                                   placeholder="Example: QAC000623" autocomplete="off" />
                            <small>Assign every selected stage to this report identity. It is used in report keys and the manifest and may differ from the P6 project short name. Spaces, punctuation, and international characters are supported.</small>
                        </label>
                        <label>
                            <span>Project name</span>
                            <input class="form-control" @bind="_projectName" disabled="@_isProcessing"
                                   placeholder="Governed project name" autocomplete="off" />
                        </label>
                        <label>
                            <span>State (optional)</span>
                            <input class="form-control" @bind="_tenderState" disabled="@_isProcessing"
                                   placeholder="Example: QLD, Queensland, or a custom label" autocomplete="off"
                                   aria-describedby="tender-state-guidance" />
                            <small id="tender-state-guidance">Manual State applies to all stages and is never inferred from XER data. Blank State cannot match state-based access; all-project or exact-project grants may still apply. State changes the audience of existing state grants. Only an authorised bundle publisher should classify project visibility.</small>
                        </label>
                    </div>

                    @if (_uploadedFiles.Count == 0)
                    {
                        <p class="empty-hint">Add one or more XER files. Each ordered input must contain exactly one PROJECT row and is a separate Tender stage.</p>
                    }
                    else
                    {
                        <div class="snapshot-table-wrap">
                            <table class="snapshot-table tender-stage-table">
                                <caption>
                                    Tender stage metadata. Status date defaults once from this browser's local calendar date and remains editable.
                                    Dates must use yyyy-MM-dd. Repeated filenames and file contents are valid when status dates differ.
                                </caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Stage</th>
                                        <th scope="col">XER file</th>
                                        <th scope="col">Status date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int index = 0; index < _uploadedFiles.Count; index++)
                                    {
                                        UploadedFile file = _uploadedFiles[index];
                                        <tr @key="file.SourceToken">
                                            <td>@(index + 1)</td>
                                            <th scope="row" title="@file.Name">@file.Name</th>
                                            <td>
                                                <input class="form-control" type="text" inputmode="numeric" placeholder="yyyy-MM-dd"
                                                       @bind="file.StatusDate" disabled="@_isProcessing"
                                                       aria-label="Status date for Tender stage @(index + 1), @file.Name" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="info-banner">
                            Tender Review web limit: @MaxBrowserFiles files, @MaxBrowserFileMegabytes MB each,
                            @MaxBrowserTotalMegabytes MB total. The P6 Data Date is read independently from PROJECT/last_recalc_date.
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="parse-area">
        @if (_isProcessing)
        {
            <button class="btn btn-danger btn-lg" @onclick="CancelOperation" aria-label="Cancel current operation">Cancel</button>
        }
        else if (_exportProfile == ExportProfile.ProgrammeReview)
        {
            <button class="btn btn-success btn-lg" @onclick="CreateProgrammeReviewBundle"
                    disabled="@(_isBusy || _uploadedFiles.Count == 0)" aria-label="Validate and download Programme Review bundle">
                <span class="step-number" aria-hidden="true">3</span> Create Programme Review Bundle
            </button>
        }
        else if (_exportProfile == ExportProfile.TenderReview)
        {
            <button class="btn btn-success btn-lg" @onclick="CreateTenderReviewBundle"
                    disabled="@(_isBusy || _uploadedFiles.Count == 0)" aria-label="Validate and download Tender Review bundle">
                <span class="step-number" aria-hidden="true">3</span> Create Tender Review Bundle
            </button>
        }
        else
        {
            <button class="btn btn-primary btn-lg" @onclick="ParseFiles" disabled="@(_isBusy || _uploadedFiles.Count == 0)"
                    aria-label="Parse and load tables from uploaded XER files">
                <span class="step-number" aria-hidden="true">3</span> Parse and Load Tables
            </button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_validationMessage))
    {
        <div class="validation-banner" role="alert">@_validationMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_exportWarningMessage))
    {
        <div class="warning-banner" role="status">@_exportWarningMessage</div>
    }

    @if (_isProcessing || _progressPercent > 0)
    {
        <div class="progress-section" role="progressbar" aria-valuenow="@_progressPercent" aria-valuemin="0" aria-valuemax="100"
             aria-label="@_progressMessage">
            <div class="progress-bar-container"><div class="progress-bar-fill" style="width: @(_progressPercent)%"></div></div>
            <p class="progress-label">@_progressMessage</p>
        </div>
    }

    @if (_exportProfile == ExportProfile.Standard && _allTableNames.Count > 0)
    {
        <div class="two-col">
            <div class="panel">
                <div class="panel-header">
                    <h2><span class="step-number">4</span> Tables to Export</h2>
                    <span class="table-count" aria-live="polite">@_filteredTableNames.Count tables</span>
                </div>
                <div class="panel-body">
                    <input type="text" class="table-filter" placeholder="Type to filter tables..."
                           aria-label="Filter table list" @bind="_tableFilter" @bind:event="oninput" @bind:after="FilterTables" />
                    <div class="table-actions">
                        <button class="btn btn-sm btn-secondary" @onclick="SelectAllTables">Select All</button>
                        <button class="btn btn-sm btn-secondary" @onclick="DeselectAllTables">Deselect All</button>
                    </div>
                    <ul class="table-checklist" role="list" aria-label="Available tables for export">
                        @foreach (string table in _filteredTableNames)
                        {
                            <li role="listitem">
                                <input type="checkbox" checked="@_selectedTables.Contains(table)"
                                       aria-label="@(IsEnhancedTable(table) ? $"Enhanced table: {table}" : table)"
                                       @onchange="e => ToggleTable(table, (bool)(e.Value ?? false))" />
                                <span class="@(IsEnhancedTable(table) ? "enhanced" : "")">@table</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header"><h2>Activity Log</h2></div>
                <div class="panel-body">
                    <div class="activity-log" @ref="_logElement" aria-label="Activity log" role="log" aria-live="polite">@_activityLog</div>
                </div>
            </div>
        </div>

        <div class="export-area" role="group" aria-label="Standard export actions">
            <button class="btn btn-primary" @onclick="ExportAll" disabled="@(_isBusy || _allTableNames.Count == 0)">Export All as ZIP</button>
            <button class="btn btn-secondary" @onclick="ExportSelected" disabled="@(_isBusy || _selectedTables.Count == 0)">Export Selected as ZIP</button>
            <button class="btn btn-info" @onclick="ExportPowerBi" disabled="@(_isBusy || !_allTableNames.Any(IsEnhancedTable))">Export Power BI as ZIP</button>
        </div>
    }

    @if (_exportProfile != ExportProfile.Standard && !string.IsNullOrWhiteSpace(_activityLog))
    {
        <div class="panel">
            <div class="panel-header"><h2>@ReviewProfileDisplayName Activity</h2></div>
            <div class="panel-body">
                <div class="activity-log" @ref="_logElement" aria-label="@ReviewProfileDisplayName activity log" role="log" aria-live="polite">@_activityLog</div>
            </div>
        </div>
    }
</div>

@code {
    private const int MaxBrowserFiles = 24;
    private const int MaxBrowserFileMegabytes = 128;
    private const int MaxBrowserTotalMegabytes = 256;
    private const long MaxBrowserFileBytes = MaxBrowserFileMegabytes * 1024L * 1024L;
    private const long MaxBrowserTotalBytes = MaxBrowserTotalMegabytes * 1024L * 1024L;
    private const int MaxStandardFiles = 20;
    private const long MaxStandardFileBytes = 100L * 1024 * 1024;
    private const long BrowserWarningBytes = 64L * 1024 * 1024;

    private enum ExportProfile { Standard, ProgrammeReview, TenderReview }

    private readonly List<UploadedFile> _uploadedFiles = new();
    private readonly HashSet<string> _selectedTables = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _allTableNames = new();
    private List<string> _filteredTableNames = new();
    private ExportProfile _selectedExportProfile;
    private ExportProfile _exportProfile
    {
        get => _selectedExportProfile;
        set
        {
            if (_selectedExportProfile == value || _isProcessing || _disposed) return;
            _uploads.Invalidate();
            _selectedExportProfile = value;
            ClearResults(keepLog: false);
        }
    }
    private bool _generatePowerBiTables;
    private bool _isProcessing;
    private bool _isDragOver;
    private bool _fileSizeWarning;
    private int _progressPercent;
    private string _progressMessage = string.Empty;
    private string _tableFilter = string.Empty;
    private string _activityLog = string.Empty;
    private string _validationMessage = string.Empty;
    private string _exportWarningMessage = string.Empty;
    private string _projectCode = string.Empty;
    private string _projectName = string.Empty;
    private string _tenderState = string.Empty;
    private string _programmeType = string.Empty;
    private readonly BrowserUploadSession _uploads = new();
    private bool _disposed;
    private long _operationVersion;
    private int _pendingUploadBatches;
    private long _fileInputGeneration;
    private bool _isUploading => _uploads.IsUploading || _pendingUploadBatches > 0;
    private bool _isBusy => _isProcessing || _isUploading || _disposed;
    private bool _standardParsed;
    private BrowserProcessingEngine? _engine;
    private CancellationTokenSource? _cts;
    private ElementReference _logElement;

    private string ReviewProfileDisplayName => _exportProfile == ExportProfile.TenderReview
        ? "Tender Review"
        : "Programme Review";

    protected override void OnInitialized() => _engine = new BrowserProcessingEngine(JS);

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _isDragOver = false;
        if (_isBusy) return;
        BrowserUploadSession.Batch? batch = _uploads.TryBegin();
        if (batch is null) return;
        _pendingUploadBatches++;
        var registered = new List<string>();
        bool committed = false;
        StateHasChanged();
        try
        {
            bool programmeReview = _exportProfile == ExportProfile.ProgrammeReview;
            bool tenderReview = _exportProfile == ExportProfile.TenderReview;
            int maximumFiles = programmeReview || tenderReview ? MaxBrowserFiles : MaxStandardFiles;
            long maximumFileBytes = programmeReview || tenderReview ? MaxBrowserFileBytes : MaxStandardFileBytes;
            IReadOnlyList<IBrowserFile> selectedFiles = e.GetMultipleFiles(maximumFiles);
            string addedLocalStatusDate = await CaptureBrowserLocalDateForUploadAsync(tenderReview);
            batch.Token.ThrowIfCancellationRequested();
            long totalBytes = _uploadedFiles.Sum(file => file.Size);
            var pending = new List<UploadedFile>(selectedFiles.Count);
            var skippedNames = new List<string>();
            var undetectedDataDateNames = new List<string>();
            for (int index = 0; index < selectedFiles.Count; index++)
            {
                IBrowserFile browserFile = selectedFiles[index];
                if (!browserFile.Name.EndsWith(".xer", StringComparison.OrdinalIgnoreCase)
                    || programmeReview && _uploadedFiles.Concat(pending).Any(file => file.Name.Equals(browserFile.Name, StringComparison.OrdinalIgnoreCase)))
                { skippedNames.Add(browserFile.Name); continue; }
                batch.Token.ThrowIfCancellationRequested();
                if (_uploadedFiles.Count + pending.Count >= maximumFiles)
                    throw new InvalidOperationException($"This profile accepts at most {maximumFiles} XER files.");
                if (browserFile.Size > maximumFileBytes)
                    throw new InvalidOperationException($"{browserFile.Name} is larger than this profile's {maximumFileBytes / (1024 * 1024)} MB per-file limit.");
                if (totalBytes + browserFile.Size > MaxBrowserTotalBytes)
                    throw new InvalidOperationException($"The selected history exceeds the {MaxBrowserTotalMegabytes} MB browser limit. Use the Windows app for larger histories.");
                string sourceToken = _uploads.NextSourceToken(batch);
                registered.Add(sourceToken);
                BrowserResult metadata = await _engine!.RegisterAsync(new BrowserSource(sourceToken, browserFile.Name, browserFile.Size), index, batch.Token);
                DateOnly? detectedDataDate = DateOnly.TryParseExact(metadata.DataDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly date) ? date : null;
                if (programmeReview && detectedDataDate is null) undetectedDataDateNames.Add(browserFile.Name);
                ProgrammeReviewUploadSuggestion suggestion = ProgrammeReviewUploadMetadata.Infer(browserFile.Name, detectedDataDate);
                pending.Add(new UploadedFile
                {
                    SourceToken = sourceToken, Name = browserFile.Name, Size = browserFile.Size, SourceSha256 = metadata.SourceSha256,
                    Status = "Ready", SnapshotKind = suggestion.SnapshotKind, SnapshotTag = suggestion.SnapshotTag,
                    MonthUpdate = suggestion.MonthUpdate, DataDate = metadata.DataDate ?? string.Empty, StatusDate = addedLocalStatusDate
                });
                totalBytes += browserFile.Size;
            }
            committed = _uploads.TryCommit(batch, () =>
            {
                BrowserUploadSession.ValidateCombined(_uploadedFiles.Concat(pending).Select(file => new BrowserUploadDescriptor(file.Name, file.Size)),
                    maximumFiles, maximumFileBytes, MaxBrowserTotalBytes, allowRepeatedNames: !programmeReview);
                if (pending.Count > 0) { _uploadedFiles.AddRange(pending); ClearResults(keepLog: false); }
            });
            if (!committed) return;
            var notices = new List<string>();
            if (skippedNames.Count > 0)
                notices.Add((programmeReview ? "Skipped unsupported or duplicate file name(s): " : "Skipped unsupported file(s): ") + string.Join(", ", skippedNames));
            if (undetectedDataDateNames.Count > 0)
                notices.Add("Data date could not be detected from one unambiguous PROJECT row; enter it manually for: " + string.Join(", ", undetectedDataDateNames));
            _validationMessage = string.Join(" ", notices);
        }
        catch (OperationCanceledException) when (batch.Token.IsCancellationRequested) { }
        catch (Exception ex) { if (_uploads.IsCurrent(batch)) _validationMessage = "Files were not added: " + ex.Message; }
        finally
        {
            try
            {
                if (!committed && !_disposed)
                    foreach (string token in registered)
                    {
                        if (_disposed) break;
                        await _engine!.RemoveAsync(token);
                    }
            }
            finally
            {
                try { _uploads.Complete(batch); }
                finally
                {
                    _pendingUploadBatches--;
                    _fileInputGeneration++;
                    if (!_disposed) { _fileSizeWarning = IsHighMemoryHistory(); StateHasChanged(); }
                }
            }
        }
    }

    private void RemoveFile(UploadedFile file)
    {
        if (_isProcessing || _disposed) return;
        _uploads.Invalidate();
        _uploadedFiles.Remove(file);
        _fileInputGeneration++;
        Observe(_engine!.RemoveAsync(file.SourceToken));
        _fileSizeWarning = IsHighMemoryHistory();
        ClearResults(keepLog: false);
    }

    private void ClearFiles()
    {
        if (_isProcessing || _disposed) return;
        _uploads.Invalidate();
        _uploadedFiles.Clear();
        _fileInputGeneration++;
        Observe(_engine!.ClearAsync());
        _fileSizeWarning = false;
        ClearResults(keepLog: false);
    }

    private void ClearResults(bool keepLog)
    {
        _standardParsed = false;
        if (_engine is not null) Observe(_engine.InvalidateAsync());
        foreach (UploadedFile file in _uploadedFiles) file.Status = "Ready";
        _allTableNames.Clear();
        _filteredTableNames.Clear();
        _selectedTables.Clear();
        _progressPercent = 0;
        _progressMessage = string.Empty;
        _validationMessage = string.Empty;
        _exportWarningMessage = string.Empty;
        if (!keepLog) _activityLog = string.Empty;
    }

    private void HandleDragEnter() => _isDragOver = true;
    private void HandleDragLeave() => _isDragOver = false;

    private async Task ParseFiles()
    {
        if (_isBusy || _uploadedFiles.Count == 0) return;
        UploadedFile[] stagedFiles = _uploadedFiles.ToArray();
        try { BrowserUploadSession.ValidateCombined(stagedFiles.Select(file => new BrowserUploadDescriptor(file.Name, file.Size)),
            MaxStandardFiles, MaxStandardFileBytes, MaxBrowserTotalBytes, allowRepeatedNames: true); }
        catch (InvalidOperationException ex) { _validationMessage = ex.Message; return; }
        BeginOperation("Starting standard XER parse...");
        _standardParsed = false;
        _allTableNames.Clear(); _filteredTableNames.Clear(); _selectedTables.Clear();
        try
        {
            BrowserResult result = await _engine!.RunAsync(new BrowserJob { Kind = "parse", Sources = Sources(stagedFiles) }, CreateParseProgress(stagedFiles), _cts!.Token);
            _cts.Token.ThrowIfCancellationRequested();
            _standardParsed = true;
            foreach (UploadedFile file in stagedFiles) file.Status = "Success";
            if (result.TableNames.Count == 0) { LogActivity("No tables found in the uploaded files."); return; }
            LogActivity($"Parsed {result.TableNames.Count} tables successfully.");
            _allTableNames = result.TableNames.OrderBy(name => name).ToList();
            if (_generatePowerBiTables) AddEnhancedTableNames();
            _filteredTableNames = new List<string>(_allTableNames);
            foreach (string table in _allTableNames) _selectedTables.Add(table);
            LogActivity($"{_allTableNames.Count} tables available for export.");
        }
        catch (OperationCanceledException) { LogActivity("Parsing was cancelled."); }
        catch (Exception ex) { SetOperationError($"Parse failed: {ex.Message}"); }
        finally { EndOperation(); }
    }

    private async Task CreateProgrammeReviewBundle()
    {
        if (_isBusy) return;
        if (!TryCreateProgrammeReviewRequest(out ProgrammeReviewBundleRequest? request, out string error)) { _validationMessage = error; return; }
        _standardParsed = false;
        BeginOperation("Validating Programme Review history...");
        try
        {
            BrowserResult bundle = await _engine!.RunAsync(new BrowserJob { Kind = "programme", Sources = Sources(_uploadedFiles), ProgrammeRequest = request }, CreateProgrammeReviewProgress(), _cts!.Token);
            _cts.Token.ThrowIfCancellationRequested();
            _progressMessage = "Preparing browser download..."; _progressPercent = 97; StateHasChanged();
            await _engine.CommitAsync(bundle, _cts.Token);
            SetReviewExportCompletion("Programme Review bundle", bundle.WarningCount, bundle.DiagnosticMessages);
            _progressPercent = 100;
            HashSet<string> retainedNames = bundle.RetainedSourceNames.ToHashSet(StringComparer.OrdinalIgnoreCase);
            foreach (UploadedFile file in _uploadedFiles) file.Status = retainedNames.Contains(file.Name) ? (bundle.WarningCount > 0 ? "Warnings" : "Success") : "Skipped";
            LogActivity($"Bundle: {bundle.BundleId}");
            LogActivity($"Retained {retainedNames.Count} of {_uploadedFiles.Count} supplied history snapshots; {_uploadedFiles.Count - retainedNames.Count} superseded/pre-anchor snapshot(s) were skipped.");
            LogActivity($"Sent 11 report CSV files plus XER_CSV_MANIFEST.csv ({bundle.FileCount} files) to the browser download manager. Check browser downloads for saved-file delivery.");
        }
        catch (OperationCanceledException) { LogActivity("Programme Review bundle generation was cancelled before browser download handoff."); }
        catch (Exception ex) { SetOperationError($"Programme Review bundle failed: {ex.Message}"); }
        finally { EndOperation(); }
    }

    private async Task CreateTenderReviewBundle()
    {
        if (_isBusy) return;
        UploadedFile[] stagedFiles = _uploadedFiles.ToArray();
        if (!TryCreateTenderReviewRequest(stagedFiles, out TenderReviewBundleRequest? request, out string error)) { _validationMessage = error; return; }
        _standardParsed = false;
        BeginOperation("Validating Tender Review stages...");
        try
        {
            BrowserResult bundle = await _engine!.RunAsync(new BrowserJob { Kind = "tender", Sources = Sources(stagedFiles), TenderRequest = request }, CreateTenderReviewProgress(), _cts!.Token);
            _cts.Token.ThrowIfCancellationRequested();
            _progressMessage = "Preparing browser download..."; _progressPercent = 97; StateHasChanged();
            await _engine.CommitAsync(bundle, _cts.Token);
            SetReviewExportCompletion("Tender Review bundle", bundle.WarningCount, bundle.DiagnosticMessages);
            _progressPercent = 100;
            foreach (UploadedFile file in stagedFiles) file.Status = bundle.WarningCount > 0 ? "Warnings" : "Success";
            LogActivity($"Bundle: {bundle.BundleId}");
            LogActivity($"Exported {stagedFiles.Length} ordered Tender stage(s). Repeated source names and hashes remain distinct by stage identity.");
            LogActivity($"Sent 11 report CSV files plus XER_CSV_MANIFEST.csv ({bundle.FileCount} files) to the browser download manager. Check browser downloads for saved-file delivery.");
        }
        catch (OperationCanceledException) { LogActivity("Tender Review bundle generation was cancelled before browser download handoff."); }
        catch (Exception ex) { SetOperationError($"Tender Review bundle failed: {ex.Message}"); }
        finally { EndOperation(); }
    }

    private bool TryCreateTenderReviewRequest(
        IReadOnlyList<UploadedFile> stagedFiles,
        out TenderReviewBundleRequest? request,
        out string error)
    {
        request = null;
        error = string.Empty;
        if (string.IsNullOrWhiteSpace(_projectCode)) { error = "Reporting project code is required."; return false; }
        string projectCode = TenderReviewNaming.NormalizeProjectCode(_projectCode);
        if (_projectName.Trim().Length == 0) { error = "Project name is required."; return false; }
        if (stagedFiles.Count == 0) { error = "Add at least one XER file."; return false; }
        if (stagedFiles.Count > MaxBrowserFiles)
        { error = $"Tender Review supports at most {MaxBrowserFiles} files in the browser. Use the Windows app or Tender Review CLI for this build."; return false; }
        UploadedFile? oversized = stagedFiles.FirstOrDefault(file => file.Size > MaxBrowserFileBytes);
        if (oversized is not null)
        { error = $"{oversized.Name} exceeds the {MaxBrowserFileMegabytes} MB Tender Review browser limit. Use the Windows app or Tender Review CLI."; return false; }
        if (stagedFiles.Sum(file => file.Size) > MaxBrowserTotalBytes)
        { error = $"These Tender stages exceed the {MaxBrowserTotalMegabytes} MB browser limit. Use the Windows app or Tender Review CLI."; return false; }

        try
        {
            TenderReviewSource[] sources = TenderReviewWebContract.CreateOrderedSources(
                stagedFiles.Select(file => new TenderReviewWebSourceInput(
                    file.SourceToken,
                    file.Name,
                    file.StatusDate)))
                .ToArray();
            request = new TenderReviewBundleRequest
            {
                ProjectCode = projectCode,
                ProjectName = _projectName.Trim(),
                State = TenderReviewNaming.NormalizeState(_tenderState),
                ExportedAtUtc = DateTimeOffset.UtcNow,
                Sources = sources
            };
            return true;
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
            return false;
        }
    }

    private bool TryCreateProgrammeReviewRequest(out ProgrammeReviewBundleRequest? request, out string error)
    {
        request = null;
        error = string.Empty;
        if (string.IsNullOrWhiteSpace(_projectCode)) { error = "Project code is required."; return false; }
        string projectCode = ProgrammeReviewNaming.NormalizeProjectCode(_projectCode);
        if (_projectName.Trim().Length == 0) { error = "Project name is required."; return false; }
        if (_programmeType is not ("C" or "T")) { error = "Select programme type C or T."; return false; }
        if (_uploadedFiles.Count == 0) { error = "Add at least one XER file."; return false; }
        if (HasDuplicateOriginalFilenames())
        { error = "Programme Review does not accept duplicate XER filenames. Remove duplicate names or use Tender Review."; return false; }
        if (_uploadedFiles.Count > MaxBrowserFiles)
        { error = $"Programme Review supports at most {MaxBrowserFiles} files in the browser. Use the Windows app for this history."; return false; }
        UploadedFile? oversized = _uploadedFiles.FirstOrDefault(file => file.Size > MaxBrowserFileBytes);
        if (oversized is not null)
        { error = $"{oversized.Name} exceeds the {MaxBrowserFileMegabytes} MB Programme Review browser limit. Use the Windows app."; return false; }
        if (_uploadedFiles.Sum(file => file.Size) > MaxBrowserTotalBytes)
        { error = $"This history exceeds the {MaxBrowserTotalMegabytes} MB Programme Review browser limit. Use the Windows app."; return false; }

        var snapshots = new List<ProgrammeReviewSnapshot>(_uploadedFiles.Count);
        foreach (UploadedFile file in _uploadedFiles)
        {
            if (!DateOnly.TryParseExact(file.MonthUpdate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly monthUpdate))
            { error = $"{file.Name}: Month update must use yyyy-MM-dd."; return false; }
            if (string.IsNullOrWhiteSpace(file.DataDate))
            { error = $"{file.Name}: Data date could not be detected from PROJECT/last_recalc_date. Enter it manually as yyyy-MM-dd."; return false; }
            if (!DateOnly.TryParseExact(file.DataDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly dataDate))
            { error = $"{file.Name}: Data date must use yyyy-MM-dd."; return false; }

            ProgrammeReviewSnapshotKind kind;
            if (file.SnapshotKind == "Baseline") kind = ProgrammeReviewSnapshotKind.Baseline;
            else if (file.SnapshotKind == "Update") kind = ProgrammeReviewSnapshotKind.Update;
            else { error = $"{file.Name}: Select baseline or update."; return false; }
            if (kind == ProgrammeReviewSnapshotKind.Update && monthUpdate.Day != 1)
            { error = $"{file.Name}: Update Month update must use the first day of its YYMM month."; return false; }

            snapshots.Add(new ProgrammeReviewSnapshot
            {
                OriginalXerFilename = file.Name,
                SnapshotKind = kind,
                SnapshotTag = file.SnapshotTag.Trim().ToUpperInvariant(),
                MonthUpdate = monthUpdate,
                DataDate = dataDate,
                SourceSha256 = file.SourceSha256
            });
        }

        request = new ProgrammeReviewBundleRequest
        {
            ProjectCode = projectCode,
            ProjectName = _projectName.Trim(),
            ProgrammeType = _programmeType,
            ExportedAtUtc = DateTimeOffset.UtcNow,
            Snapshots = snapshots
        };
        return true;
    }

    private IProgress<ProcessingService.DetailedProgress> CreateParseProgress(IReadOnlyList<UploadedFile> stagedFiles)
    {
        long version = _operationVersion;
        return new Progress<ProcessingService.DetailedProgress>(progress =>
        {
            if (_disposed || version != _operationVersion) return;
            _progressPercent = Math.Max(_progressPercent, Math.Clamp(progress.Percent, 0, 97));
            _progressMessage = progress.Message ?? string.Empty;
            if (!string.IsNullOrEmpty(progress.FilePath) && !string.IsNullOrEmpty(progress.FileStatus))
            {
                UploadedFile? file = progress.InputIndex is int index && index >= 0 && index < stagedFiles.Count
                    ? stagedFiles[index]
                    : null;
                if (file is not null) file.Status = progress.FileStatus;
            }
            RefreshProgress(version);
        });
    }

    private IProgress<ProcessingService.DetailedProgress> CreateProgrammeReviewProgress()
    {
        long version = _operationVersion;
        return new Progress<ProcessingService.DetailedProgress>(progress =>
        {
            if (_disposed || version != _operationVersion) return;
            _progressPercent = Math.Max(_progressPercent, Math.Clamp(progress.Percent, 0, 97));
            _progressMessage = progress.Message ?? string.Empty;
            if (!string.IsNullOrEmpty(progress.FilePath) && !string.IsNullOrEmpty(progress.FileStatus))
            {
                UploadedFile? file = _uploadedFiles.FirstOrDefault(item => item.Name == progress.FilePath);
                if (file is not null) file.Status = progress.FileStatus;
            }
            RefreshProgress(version);
        });
    }

    private IProgress<ProcessingService.DetailedProgress> CreateTenderReviewProgress()
    {
        long version = _operationVersion;
        return new Progress<ProcessingService.DetailedProgress>(progress =>
        {
            if (_disposed || version != _operationVersion) return;
            _progressPercent = Math.Max(_progressPercent, Math.Clamp(progress.Percent, 0, 97));
            _progressMessage = progress.Message ?? string.Empty;
            if (!string.IsNullOrEmpty(progress.FilePath) && !string.IsNullOrEmpty(progress.FileStatus))
            {
                UploadedFile? file = _uploadedFiles.FirstOrDefault(item =>
                    string.Equals(item.SourceToken, progress.FilePath, StringComparison.Ordinal));
                if (file is not null) file.Status = progress.FileStatus;
            }
            RefreshProgress(version);
        });
    }

    private void RefreshProgress(long version) => _ = InvokeAsync(async () =>
    {
        if (_disposed || version != _operationVersion) return;
        StateHasChanged();
        await ScrollLogToBottom();
    });

    private void BeginOperation(string message, bool resetFileStatuses = true)
    {
        _operationVersion++;
        _isProcessing = true;
        _cts = new CancellationTokenSource();
        _validationMessage = string.Empty;
        _exportWarningMessage = string.Empty;
        _progressPercent = 0;
        _progressMessage = message;
        _activityLog = string.Empty;
        if (resetFileStatuses)
            foreach (UploadedFile file in _uploadedFiles) file.Status = "Pending";
        LogActivity(message);
    }

    private void EndOperation()
    {
        _operationVersion++;
        _isProcessing = false;
        _progressPercent = 0;
        _cts?.Dispose();
        _cts = null;
        if (!_disposed) StateHasChanged();
    }

    private void SetOperationError(string message)
    {
        _validationMessage = message;
        LogActivity(message);
    }

    private void SetExportCompletion(string subject, int warningCount)
    {
        _progressMessage = warningCount > 0
            ? $"{subject} completed with warnings."
            : $"{subject} complete.";
        _exportWarningMessage = warningCount > 0
            ? $"{_progressMessage} {warningCount} data-quality issue(s). See XER_DATA_QUALITY.csv in the download " +
              "for affected tables and fields, original source values, and any unallocated actual or remaining quantities. Check browser downloads for saved-file delivery."
            : string.Empty;
        LogActivity(warningCount > 0 ? _exportWarningMessage : _progressMessage);
    }

    private void SetReviewExportCompletion(string subject, int warningCount, IReadOnlyList<string> diagnosticMessages)
    {
        _progressMessage = warningCount > 0
            ? $"{subject} completed with warnings."
            : $"{subject} complete.";
        _exportWarningMessage = warningCount > 0
            ? $"{_progressMessage} {warningCount} data-quality issue(s). See the activity log for source diagnostics. " +
              "The bundle contains eleven report CSV files and the manifest only. Check browser downloads for saved-file delivery."
            : string.Empty;
        LogActivity(warningCount > 0 ? _exportWarningMessage : _progressMessage);
        foreach (string message in diagnosticMessages)
            LogActivity(message);
    }

    private void AddEnhancedTableNames()
    {
        if (!_standardParsed) return;
        var enhanced = new List<string>();
        // Show every Enhanced output with a primary source; missing lookups
        // are reported by Core without hiding otherwise available source rows.
        if (_allTableNames.Contains(TableNames.Task, StringComparer.OrdinalIgnoreCase))
        { enhanced.Add(EnhancedTableNames.XerTask01); enhanced.Add(EnhancedTableNames.XerBaseline04); }
        if (_allTableNames.Contains(TableNames.Project, StringComparer.OrdinalIgnoreCase)) enhanced.Add(EnhancedTableNames.XerProject02);
        if (_allTableNames.Contains(TableNames.ProjWbs, StringComparer.OrdinalIgnoreCase)) enhanced.Add(EnhancedTableNames.XerProjWbs03);
        if (_allTableNames.Contains(TableNames.TaskPred, StringComparer.OrdinalIgnoreCase)) enhanced.Add(EnhancedTableNames.XerPredecessor06);
        if (_allTableNames.Contains(TableNames.ActvType, StringComparer.OrdinalIgnoreCase)) enhanced.Add(EnhancedTableNames.XerActvType07);
        if (_allTableNames.Contains(TableNames.ActvCode, StringComparer.OrdinalIgnoreCase)) enhanced.Add(EnhancedTableNames.XerActvCode08);
        if (_allTableNames.Contains(TableNames.TaskActv, StringComparer.OrdinalIgnoreCase)) enhanced.Add(EnhancedTableNames.XerTaskActv09);
        if (_allTableNames.Contains(TableNames.Calendar, StringComparer.OrdinalIgnoreCase))
        { enhanced.Add(EnhancedTableNames.XerCalendar10); enhanced.Add(EnhancedTableNames.XerCalendarDetailed11); }
        if (_allTableNames.Contains(TableNames.Rsrc, StringComparer.OrdinalIgnoreCase)) enhanced.Add(EnhancedTableNames.XerRsrc12);
        if (_allTableNames.Contains(TableNames.TaskRsrc, StringComparer.OrdinalIgnoreCase)) enhanced.Add(EnhancedTableNames.XerTaskRsrc13);
        if (_allTableNames.Contains(TableNames.Umeasure, StringComparer.OrdinalIgnoreCase)) enhanced.Add(EnhancedTableNames.XerUmeasure14);
        if (_allTableNames.Contains(TableNames.TaskRsrc, StringComparer.OrdinalIgnoreCase))
            enhanced.Add(EnhancedTableNames.XerResourceDist15);
        foreach (string name in enhanced)
            if (!_allTableNames.Contains(name, StringComparer.OrdinalIgnoreCase)) _allTableNames.Add(name);
        _allTableNames.Sort(StringComparer.OrdinalIgnoreCase);
    }

    private Task ExportAll() => ExportTables(_allTableNames);

    private async Task ExportTables(List<string> tables)
    {
        if (_isBusy || !_standardParsed || tables.Count == 0) return;
        BeginOperation($"Exporting {tables.Count} tables...", resetFileStatuses: false);
        try
        {
            BrowserResult result = await _engine!.RunAsync(new BrowserJob { Kind = "export", Sources = Sources(_uploadedFiles), Tables = tables }, CreateParseProgress(_uploadedFiles), _cts!.Token);
            _cts.Token.ThrowIfCancellationRequested();
            _progressMessage = "Preparing browser download..."; _progressPercent = 97; StateHasChanged();
            await _engine.CommitAsync(result, _cts.Token);
            SetExportCompletion("Export", result.WarningCount);
            foreach (UploadedFile file in _uploadedFiles) file.Status = result.WarningCount > 0 ? "Warnings" : "Success";
            LogActivity($"{result.FileCount} CSV files sent to the browser download manager. Check browser downloads for saved-file delivery.");
        }
        catch (OperationCanceledException) { LogActivity("Export was cancelled before browser download handoff."); }
        catch (Exception ex) { SetOperationError($"Export failed: {ex.Message}"); }
        finally { EndOperation(); }
    }

    private Task ExportSelected() => ExportTables(_selectedTables.ToList());
    private Task ExportPowerBi() => ExportTables(_allTableNames.Where(IsEnhancedTable).ToList());

    private void CancelOperation()
    {
        _cts?.Cancel();
        LogActivity("Cancellation requested...");
    }

    private static BrowserSource[] Sources(IEnumerable<UploadedFile> files) => files
        .Select(file => new BrowserSource(file.SourceToken, file.Name, file.Size, file.SourceSha256)).ToArray();

    private async void Observe(Task task)
    {
        try { await task; }
        catch (Exception ex) { if (!_disposed) SetOperationError($"Browser session update failed: {ex.Message}"); }
    }

    private void ToggleTable(string table, bool selected)
    { if (selected) _selectedTables.Add(table); else _selectedTables.Remove(table); }
    private void SelectAllTables() { foreach (string table in _filteredTableNames) _selectedTables.Add(table); }
    private void DeselectAllTables() { foreach (string table in _filteredTableNames) _selectedTables.Remove(table); }
    private void FilterTables() => _filteredTableNames = string.IsNullOrWhiteSpace(_tableFilter)
        ? new List<string>(_allTableNames)
        : _allTableNames.Where(table => table.Contains(_tableFilter, StringComparison.OrdinalIgnoreCase)).ToList();
    private static bool IsEnhancedTable(string name) =>
        name.Length > 3 && char.IsDigit(name[0]) && char.IsDigit(name[1]) && name[2] == '_';

    private void LogActivity(string message)
    {
        if (!_disposed) _activityLog += $"[{DateTime.Now:HH:mm:ss}] {message}\n";
    }
    private async Task ScrollLogToBottom()
    { try { await JS.InvokeVoidAsync("scrollToBottom", _logElement); } catch { } }

    private async Task<string> ReadBrowserLocalDateAsync()
    {
        string value = await JS.InvokeAsync<string>(TenderReviewWebContract.BrowserLocalDateJsIdentifier);
        return TenderReviewWebContract.CaptureAddedLocalIsoDate(value);
    }

    private async Task<string> CaptureBrowserLocalDateForUploadAsync(bool tenderReview)
    {
        try
        {
            return await ReadBrowserLocalDateAsync();
        }
        catch when (!tenderReview)
        {
            // Tender metadata is inert in Standard/Programme Review. Preserve those upload flows if JS is unavailable.
            return string.Empty;
        }
    }

    private bool HasDuplicateOriginalFilenames() =>
        _uploadedFiles
            .GroupBy(file => file.Name, StringComparer.OrdinalIgnoreCase)
            .Any(group => group.Count() > 1);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _operationVersion++;
        _uploads.Dispose();
        _cts?.Cancel();
        if (_engine is not null) await _engine.DisposeAsync();
        _cts?.Dispose();
        _cts = null;
    }

    private bool IsHighMemoryHistory() =>
        _uploadedFiles.Sum(file => file.Size) > BrowserWarningBytes;

    private sealed class UploadedFile
    {
        public string SourceToken { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public long Size { get; init; }
        public string? SourceSha256 { get; init; }
        public string Status { get; set; } = "Ready";
        public string SnapshotKind { get; set; } = string.Empty;
        public string SnapshotTag { get; set; } = string.Empty;
        public string MonthUpdate { get; set; } = string.Empty;
        public string DataDate { get; set; } = string.Empty;
        public string StatusDate { get; set; } = string.Empty;
    }
}
