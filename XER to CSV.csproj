    <None Remove="XerToCsvConverter.Web\**" />
    <None Remove="XerToCsvConverter.ProgrammeReview.Cli\**" />
    <None Remove="XerToCsvConverter.TenderReview.Cli\**" />
    <None Remove="XerToCsvConverter.RelationshipAudit.Cli\**" />
